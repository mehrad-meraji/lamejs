{
  "name": "@_mehrad/lamejs",
  "version": "2.0.0",
  "description": "MP3 (CBR) encoder in TypeScript, ported from LAME. ESM only, tree-shakeable, no dependencies.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test test/",
    "bench": "tsc -p . && node test/bench.js",
    "size": "tsc -p . && esbuild dist/index.js --bundle --minify --format=esm --log-level=error | gzip -9 | wc -c",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mp3",
    "encoder",
    "audio",
    "webaudio"
  ],
  "author": "Alex Zhukov",
  "license": "LGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehrad-meraji/lamejs.git"
  },
  "bugs": {
    "url": "https://github.com/mehrad-meraji/lamejs/issues"
  },
  "homepage": "https://github.com/mehrad-meraji/lamejs#readme",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
